/* ==========================================================
   3) UTILITÁRIOS
========================================================== */
function normalize(s){
  return (s||'').toString().normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().trim();
}

const FREE_EMAIL_DOMAINS = [
  'gmail.com','hotmail.com','hotmail.com.br','outlook.com','outlook.com.br','live.com','live.com.br',
  'yahoo.com','yahoo.com.br','icloud.com','me.com','aol.com','bol.com.br','uol.com.br','ig.com.br',
  'terra.com.br','r7.com','globo.com','globomail.com','zipmail.com.br','oi.com.br','msn.com',
  'protonmail.com','gmx.com','yandex.com','mail.com','zoho.com','yopmail.com','126.com','163.com',
  'qq.com','rocketmail.com','ymail.com','pop.com.br','superig.com.br'
];

function isCorporateEmail(email){
  const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!re.test(email)) return { ok:false, reason:'formato' };
  const domain = email.split('@')[1].toLowerCase().trim();
  if (FREE_EMAIL_DOMAINS.includes(domain)) return { ok:false, reason:'pessoal' };
  return { ok:true };
}

function wireEmailValidation(fieldId){
  const field = document.getElementById(fieldId);
  const input = field.querySelector('input');
  input.addEventListener('blur', () => {
    if (!input.value) return;
    const check = isCorporateEmail(input.value);
    field.classList.toggle('invalid', !check.ok);
  });
  input.addEventListener('input', () => field.classList.remove('invalid'));
}
wireEmailValidation('fEmailFound');
wireEmailValidation('fEmailResearch');
wireEmailValidation('fEmailVarejista');

document.getElementById('downloadLink').addEventListener('click', (e)=>{
  if (e.currentTarget.getAttribute('aria-disabled') === 'true') e.preventDefault();
});

/* ==========================================================
