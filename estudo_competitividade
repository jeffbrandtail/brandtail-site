========================================================== */
let audience = 'marca';
const toggleWrap = document.getElementById('toggleWrap');
document.querySelectorAll('.toggle-btn').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    audience = btn.dataset.audience;
    toggleWrap.dataset.active = audience;
    document.querySelectorAll('.toggle-btn').forEach(b=>b.classList.toggle('active', b===btn));

    const isVarejista = audience === 'varejista';
    document.getElementById('searchCard').classList.toggle('hidden', isVarejista);
    document.getElementById('varejistaCard').classList.toggle('hidden', !isVarejista);
    document.getElementById('resultZone').style.display='none';
    hideSuggest();

    if (isVarejista) return;

    document.getElementById('statLineMarca').classList.toggle('hidden', audience!=='marca');
    document.getElementById('statLineSeller').classList.toggle('hidden', audience!=='seller');
    document.getElementById('searchInput').placeholder = audience==='marca' ? 'Digite o nome da sua marca...' : 'Digite o nome da sua loja...';
    document.getElementById('searchInput').value='';
  });
});

