  const emailCheck = isCorporateEmail(emailInput.value.trim());
  document.getElementById('fNameVarejista').classList.toggle('invalid', !nameOk);
  document.getElementById('fCompanyVarejista').classList.toggle('invalid', !companyOk);
  document.getElementById('fEmailVarejista').classList.toggle('invalid', !emailCheck.ok);
  if (!nameOk || !companyOk || !emailCheck.ok) return false;

  const btn = document.querySelector('#leadFormVarejista button[type="submit"]');
  const errBox = document.getElementById('submitErrVarejista');
  btn.disabled = true; btn.textContent = 'Enviando...';
  errBox.classList.remove('show');

  (async ()=>{
    const ok = await saveLead('leads_varejista_trial', {
      tipo: 'varejista',
      nome_lead: nameInput.value.trim(),
      empresa: companyInput.value.trim(),
      email_lead: emailInput.value.trim(),
      dominio_email: emailInput.value.trim().split('@')[1]
    });

    btn.disabled = false; btn.textContent = 'Quero o plugin no meu site';

    if (!ok) {
      errBox.classList.add('show');
      return;
    }
    document.getElementById('leadFormVarejista').classList.remove('show');
    document.getElementById('successVarejista').classList.remove('hidden');
  })();
  return false;
};

/* ==========================================================
   5) BUSCA + AUTOCOMPLETE
========================================================== */
const searchInput = document.getElementById('searchInput');
const suggestBox = document.getElementById('suggestBox');

function currentDB(){ return audience==='marca' ? MARCA_DB : SELLER_DB; }

function hideSuggest(){ suggestBox.style.display='none'; suggestBox.innerHTML=''; }

searchInput.addEventListener('input', ()=>{
  const q = normalize(searchInput.value);
  if (!q){ hideSuggest(); return; }
  const matches = currentDB().filter(item => normalize(item.nome).includes(q)).slice(0,8);
  if (!matches.length){ hideSuggest(); return; }
  suggestBox.innerHTML = matches.map(m=>`<div class="suggest-item" data-nome="${m.nome}">${m.nome}</div>`).join('');
  suggestBox.style.display='block';
  suggestBox.querySelectorAll('.suggest-item').forEach(el=>{
    el.addEventListener('click', ()=>{
      searchInput.value = el.dataset.nome;
      hideSuggest();
      runSearch();
    });
  });
});

document.addEventListener('click', (e)=>{
  if (!e.target.closest('.search-row')) hideSuggest();
});

document.getElementById('searchBtn').addEventListener('click', runSearch);
searchInput.addEventListener('keydown', (e)=>{ if(e.key==='Enter'){ hideSuggest(); runSearch(); } });

function runSearch(){
  const term = searchInput.value.trim();
  if (!term) return;
  const q = normalize(term);
  const match = currentDB().find(item => normalize(item.nome) === q) ||
                currentDB().find(item => normalize(item.nome).includes(q));

  document.getElementById('resultZone').style.display='block';
  resetLeadStates();

  if (match){
    showFound(match);
  } else {
    showNotFound(term);
  }
  document.getElementById('resultZone').scrollIntoView({behavior:'smooth', block:'start'});
}

function resetLeadStates(){
  document.getElementById('foundPanel').classList.add('hidden');
  document.getElementById('notFoundPanel').classList.add('hidden');
  document.getElementById('leadFormFound').classList.remove('show');
  document.getElementById('leadFormResearch').classList.remove('show');
  document.getElementById('successFound').classList.add('hidden');
  document.getElementById('successResearch').classList.add('hidden');
  document.getElementById('ctaDefault').classList.remove('hidden');
}

function fmtInt(n){ return Number(n).toLocaleString('pt-BR'); }
function fmtPct(n){ const v = Number(n); return (v>0?'+':'') + v.toFixed(1).replace('.',',') + '%'; }

function showFound(item){
  document.getElementById('foundPanel').classList.remove('hidden');
  document.getElementById('foundName').textContent = item.nome;
  document.getElementById('foundTag').textContent = audience==='marca' ? 'Indústria' : 'Seller';

  const difClass = item.dif_media_pct > 0 ? 'red' : (item.dif_media_pct < 0 ? 'green' : '');
  document.getElementById('metricGrid').innerHTML = `
    <div class="metric"><div class="v">${fmtInt(item.total_itens)}</div><div class="l">Total de itens</div></div>
    <div class="metric"><div class="v ${difClass}">${fmtPct(item.dif_media_pct)}</div><div class="l">Diferença média de preço</div></div>
    <div class="metric"><div class="v">${fmtInt(item.itens_comparados)}</div><div class="l">Itens comparados</div></div>
    <div class="metric"><div class="v red">${fmtInt(item.qtd_mais_caros)}</div><div class="l">Itens mais caros</div></div>
    <div class="metric"><div class="v red">${fmtPct(item.dif_media_mais_caros_pct)}</div><div class="l">Dif. média (mais caros)</div></div>
    <div class="metric"><div class="v green">${fmtInt(item.qtd_mais_baratos)}</div><div class="l">Itens mais baratos</div></div>
    <div class="metric"><div class="v">${fmtInt(item.qtd_iguais)}</div><div class="l">Itens iguais</div></div>
  `;

  document.getElementById('openLeadForm').onclick = ()=>{
    document.getElementById('ctaDefault').classList.add('hidden');
    document.getElementById('leadFormFound').classList.add('show');
  };

  document.getElementById('leadFormFound').onsubmit = (e)=>{
    e.preventDefault();
    const nameInput = document.querySelector('#fNameFound input');
    const emailInput = document.querySelector('#fEmailFound input');
    const nameOk = nameInput.value.trim().length>1;
    const emailCheck = isCorporateEmail(emailInput.value.trim());
    document.getElementById('fNameFound').classList.toggle('invalid', !nameOk);
    document.getElementById('fEmailFound').classList.toggle('invalid', !emailCheck.ok);
    if (!nameOk || !emailCheck.ok) return false;

    const btn = document.querySelector('#leadFormFound button[type="submit"]');
    const errBox = document.getElementById('submitErrFound');
    btn.disabled = true; btn.textContent = 'Enviando...';
    errBox.classList.remove('show');

    (async ()=>{
      const ok = await saveLead('leads_estudo_completo', {
        tipo: audience,
        empresa: item.nome,
        nome_lead: nameInput.value.trim(),
        email_lead: emailInput.value.trim(),
        dominio_email: emailInput.value.trim().split('@')[1]
      });

      btn.disabled = false; btn.textContent = 'Enviar e baixar estudo';

      if (!ok) {
        errBox.classList.add('show');
        return;
      }

      document.getElementById('leadFormFound').classList.remove('show');
      document.getElementById('successFound').classList.remove('hidden');

      const downloadLink = document.getElementById('downloadLink');
      const downloadNote = document.getElementById('downloadNote');
      const result = await getStudyDownloadUrl(audience);
      if (result.ok) {
        downloadLink.href = result.url;
        downloadLink.removeAttribute('aria-disabled');
        downloadNote.classList.add('hidden');
      } else {
        downloadLink.href = '#';
        downloadLink.setAttribute('aria-disabled', 'true');
        downloadNote.textContent = result.reason === 'demo'
          ? 'Modo demonstração — configure o Firebase Storage (veja comentário no código) para liberar o download real aqui.'
          : 'Não conseguimos gerar o link agora, mas já enviamos o PDF para o seu e-mail.';
        downloadNote.classList.remove('hidden');
      }
    })();
    return false;
  };
}

function showNotFound(term){
  document.getElementById('notFoundPanel').classList.remove('hidden');
  document.getElementById('notFoundTitle').textContent =
    `Não encontramos "${term}" na base do estudo de ${audience==='marca' ? 'marcas' : 'sellers'}`;

  document.getElementById('openResearchForm').onclick = ()=>{
    document.getElementById('openResearchForm').classList.add('hidden');
    document.getElementById('leadFormResearch').classList.add('show');
  };

  document.getElementById('leadFormResearch').onsubmit = (e)=>{
    e.preventDefault();
    const nameInput = document.querySelector('#fNameResearch input');
    const emailInput = document.querySelector('#fEmailResearch input');
    const nameOk = nameInput.value.trim().length>1;
    const emailCheck = isCorporateEmail(emailInput.value.trim());
    document.getElementById('fNameResearch').classList.toggle('invalid', !nameOk);
    document.getElementById('fEmailResearch').classList.toggle('invalid', !emailCheck.ok);
    if (!nameOk || !emailCheck.ok) return false;

    const btn = document.querySelector('#leadFormResearch button[type="submit"]');
    const errBox = document.getElementById('submitErrResearch');
    btn.disabled = true; btn.textContent = 'Enviando...';
    errBox.classList.remove('show');

    (async ()=>{
      const ok = await saveLead('leads_pesquisa_produtos', {
        tipo: audience,
        termo_busca: term,
        nome_lead: nameInput.value.trim(),
        email_lead: emailInput.value.trim(),
        dominio_email: emailInput.value.trim().split('@')[1]
      });

      btn.disabled = false; btn.textContent = 'Solicitar pesquisa';

      if (!ok) {
        errBox.classList.add('show');
        return;
      }
      document.getElementById('leadFormResearch').classList.remove('show');
      document.getElementById('successResearch').classList.remove('hidden');
    })();
    return false;
  };
}
